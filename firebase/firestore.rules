rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isEditor() {
      return signedIn()
        && request.auth.token.email == "nj277@cornell.edu"
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function preservesActiveVersion() {
      return request.resource.data.get('activeVersion', null) == resource.data.get('activeVersion', null);
    }

    match /buildings/{buildingId} {
      allow read: if signedIn();
      allow create: if isEditor() && request.resource.data.get('activeVersion', null) == null;
      // Clients cannot move activeVersion. The publish API uses the Admin SDK, which bypasses these rules.
      allow update: if isEditor() && preservesActiveVersion();
      allow delete: if isEditor();

      match /versions/{versionId} {
        allow read: if signedIn();
        allow create, update, delete: if isEditor();

        match /{nestedDocument=**} {
          allow read: if signedIn();
          allow create, update, delete: if isEditor();
        }
      }

      match /publishes/{publishId} {
        allow read, write: if false;
      }
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}
