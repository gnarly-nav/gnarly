rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isEditor() {
      return signedIn()
        && request.auth.token.email == "nj277@cornell.edu"
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    // The connection test still uses the client SDK. Package bytes use signed URLs, which bypass these rules.
    match /buildings/firebase-test/{path=**} {
      allow read, write: if isEditor();
    }

    match /buildings/{buildingId}/{versionId}/{assetPath=**} {
      allow read: if false;
      allow write: if isEditor() && (
        assetPath.matches('zones/[^/]+/graph-edits/[^/]+\\.json') ||
        assetPath.matches('graph-edits/[^/]+\\.json') ||
        assetPath.matches('building-layout\\.json') ||
        assetPath.matches('zone-connections\\.json')
      );
    }
  }
}
