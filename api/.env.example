# firebase (default) keeps the existing Cloud Run / Cloud Functions backend.
# aws uses DynamoDB table gnarly, the private S3 bucket, and Cognito.
GNARLY_BACKEND=aws
AWS_REGION=us-east-1
GNARLY_TABLE=gnarly
GNARLY_BUCKET=gnarly-data-402275401617-us-east-1
COGNITO_USER_POOL_ID=us-east-1_pQIUmVbPJ
COGNITO_CLIENT_ID=1osnrt38iuqvf5laum1tnj1hdn
# Verified emails allowed to create, publish, upload, or edit. Comma-separated.
ADMIN_EMAILS=nj277@cornell.edu
GNARLY_CORS_ORIGINS=https://naijei.com,http://localhost:5173,http://localhost:4173
PORT=8080
# Set TRUST_PROXY=1 only behind a proxy that overwrites X-Forwarded-For.
# The Lambda Function URL passes the client IP from the event instead.
TRUST_PROXY=0
